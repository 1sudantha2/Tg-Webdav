# ── HTTP ──────────────────────────────────────────────────────────────────
# Port for the WebDAV endpoint (/dav) and the Web UI (/web).
PORT=8080

# ── Telegram credentials ──────────────────────────────────────────────────
# From https://my.telegram.org → "API development tools".
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather → /newbot.
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Private storage channel: numeric ID (-1001234567890 / 1234567890) or a
# public @username. The bot must be an ADMIN of this channel with the
# "Post messages" right.
TELEGRAM_CHANNEL_ID=-1001234567890

# ── WebDAV / Web UI credentials (HTTP Basic) ──────────────────────────────
WEBDAV_USER=admin
WEBDAV_PASSWORD=change-me

# ── Optional ──────────────────────────────────────────────────────────────
# Virtual folder where files sent to the bot DM are stored.
DEFAULT_FOLDER=general

# In-memory sliding-window chunk cache size (MB). 4 MB chunks are cached
# here to make video seeking instant; nothing is ever written to disk.
CHUNK_CACHE_SIZE_MB=64

# Pure-Go SQLite metadata index (no CGO).
DB_PATH=./data/metadata.db
